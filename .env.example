# Copy to .env and fill in. The app refuses to boot with missing keys.

# Postgres (docker-compose default shown; host port 5433 avoids clashing with
# a locally installed Postgres)
DATABASE_URL=postgres://subtracker:subtracker@localhost:5433/subtracker

# Redis (docker-compose default shown)
REDIS_URL=redis://localhost:6379

# Plaid (Sandbox for all development)
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret
PLAID_ENV=sandbox

# 32+ char key for AES-256-GCM encryption of Plaid access tokens.
# Generate: openssl rand -base64 32
TOKEN_ENC_KEY=replace-with-32-plus-character-random-key

# Resend (email)
RESEND_API_KEY=your-resend-api-key

# Auth.js session secret. Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-random-auth-secret

# Optional: Google OAuth. The Google sign-in button appears only when both are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
